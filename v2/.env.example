# New v2 database. NEVER point this at the existing data/app.db.
DB_PATH=./data/nihon.sqlite
# Create independent random strings of at least 24 characters. Do not commit real tokens.
NIHON_ADMIN_TOKEN=
NIHON_MCP_TOKEN=
# Auth.js password session: generate a unique 32+ byte secret; never prefix NEXT_PUBLIC_.
AUTH_SECRET=
# For local development only. Replace with your own HTTPS origin when deployed.
AUTH_URL=http://localhost:3000
# Hash a strong admin password via: read -sr P; printf '%s' "$P" | npm run admin:hash; unset P
NIHON_ADMIN_PASSWORD_HASH=
# AI Vocabulary Studio (server-side only; never NEXT_PUBLIC_*).
# AI is disabled if OPENAI_API_KEY is unset.
OPENAI_API_KEY=
NIHON_AI_MODEL=gpt-4.1-mini
NIHON_AI_DAILY_LIMIT=10
