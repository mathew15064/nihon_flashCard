# Server-only settings: store real values in ignored .env.local or environment.
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/nihon.sqlite

# Set 32+ random characters and never use NEXT_PUBLIC_ or VITE_ for secrets.
AUTH_SECRET=
NIHON_ADMIN_PASSWORD_HASH=
NIHON_ENABLE_SIGNUP=false

# REST/MCP credentials are separate from AI provider keys.
NIHON_ADMIN_TOKEN=
NIHON_MCP_TOKEN=
OPENAI_API_KEY=
NIHON_AI_MODEL=gpt-4.1-mini
NIHON_AI_DAILY_LIMIT=10

# REQUIRED for browser state-changing requests in production, e.g. https://nihon.example
# Set this to the exact public scheme + host (+ nonstandard port if used).
# PUBLIC_ORIGIN=
